rules_version = '2';

// MindLedger security rules. The app runs entirely in the browser, so these
// rules are the only thing standing between client records and the internet.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isMember(clinicId) {
      return hasProfile() && me().clinic_id == clinicId;
    }

    function isOwnerOf(clinicId) {
      return isMember(clinicId) && me().role == 'owner';
    }

    function isClinicianRole() {
      return me().role in ['clinician', 'psychologist'];
    }

    function isCoordinatorRole() {
      return me().role in ['front_desk', 'coordinator'];
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A clinician may only touch records of clients assigned to them; owners see the whole clinic.
    function canSeeClinical(data) {
      return isMember(data.clinic_id)
        && (me().role == 'owner'
            || (isClinicianRole()
                && (data.clinician_id == request.auth.uid || data.assigned_clinician_id == request.auth.uid)));
    }

    // New notes/assessments must point at a real client of this clinic and copy its assignment.
    function validClientLink(data) {
      let client = get(/databases/$(database)/documents/clients/$(data.client_id)).data;
      return client.clinic_id == data.clinic_id
        && client.assigned_clinician_id == data.assigned_clinician_id
        && (me().role == 'owner' || client.assigned_clinician_id == request.auth.uid);
    }

    match /clinics/{clinicId} {
      allow read: if isMember(clinicId);
      // A clinic's id is its founding owner's uid.
      allow create: if signedIn()
        && clinicId == request.auth.uid
        && request.resource.data.id == clinicId
        && !exists(userPath(request.auth.uid));
      allow update: if isOwnerOf(clinicId) && unchanged(['id']);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (userId == request.auth.uid || isMember(resource.data.clinic_id));

      allow create: if signedIn()
        && request.resource.data.id == userId
        && (
          // Founding owner registering their own clinic.
          (userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.clinic_id == userId)
          ||
          // Owner adding staff to their clinic.
          (isOwnerOf(request.resource.data.clinic_id)
            && userId != request.auth.uid
            && request.resource.data.role in ['clinician', 'psychologist', 'front_desk', 'coordinator'])
        );

      allow update: if isOwnerOf(resource.data.clinic_id) && unchanged(['id', 'clinic_id', 'role']);

      allow delete: if isOwnerOf(resource.data.clinic_id)
        && userId != request.auth.uid
        && userId != resource.data.clinic_id;
    }

    match /clients/{clientId} {
      allow read: if isMember(resource.data.clinic_id)
        && (!isClinicianRole() || resource.data.assigned_clinician_id == request.auth.uid);

      allow create: if isMember(request.resource.data.clinic_id)
        && !isClinicianRole()
        && request.resource.data.id == clientId
        && exists(userPath(request.resource.data.assigned_clinician_id))
        && get(userPath(request.resource.data.assigned_clinician_id)).data.clinic_id == request.resource.data.clinic_id;

      allow update: if isMember(resource.data.clinic_id)
        && !isClinicianRole()
        && unchanged(['id', 'clinic_id', 'assigned_clinician_id', 'created_at'])
        && (me().role == 'owner' || unchanged(['anonymized']));

      allow delete: if false;
    }

    match /session_notes/{noteId} {
      allow read: if canSeeClinical(resource.data);

      allow create: if isMember(request.resource.data.clinic_id)
        && !isCoordinatorRole()
        && request.resource.data.id == noteId
        && request.resource.data.clinician_id == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.addenda.size() == 0
        && validClientLink(request.resource.data);

      allow update: if canSeeClinical(resource.data)
        && unchanged(['id', 'clinic_id', 'client_id', 'assigned_clinician_id', 'clinician_id', 'created_at'])
        && (
          // Drafts may be edited or signed by the person signing.
          (resource.data.status == 'draft'
            && (request.resource.data.status == 'draft'
                || (request.resource.data.status == 'signed'
                    && request.resource.data.signed_by_id == request.auth.uid)))
          ||
          // Signed notes are locked: only new addenda may be appended.
          (resource.data.status == 'signed'
            && onlyChanged(['addenda', 'updated_at'])
            && request.resource.data.addenda.size() > resource.data.addenda.size()
            && request.resource.data.addenda.hasAll(resource.data.addenda))
        );

      allow delete: if false;
    }

    match /assessments/{token} {
      // Anyone holding the (48-hex-character) link can open a pending questionnaire.
      allow get: if resource.data.status == 'pending' || canSeeClinical(resource.data);
      allow list: if canSeeClinical(resource.data);

      allow create: if isMember(request.resource.data.clinic_id)
        && !isCoordinatorRole()
        && token.size() == 48
        && request.resource.data.id == token
        && request.resource.data.secure_link_token == token
        && request.resource.data.status == 'pending'
        && request.resource.data.clinician_id == request.auth.uid
        && request.resource.data.type in ['PHQ9', 'GAD7']
        && request.resource.data.expires_at_ms is int
        && validClientLink(request.resource.data);

      // The client submits answers without signing in, once, before the link expires.
      allow update: if resource.data.status == 'pending'
        && request.time.toMillis() < resource.data.expires_at_ms
        && request.resource.data.status == 'completed'
        && onlyChanged(['responses', 'score', 'severity_band', 'status', 'completed_at', 'completed_at_iso'])
        && request.resource.data.responses is map
        && request.resource.data.responses.size() == (resource.data.type == 'PHQ9' ? 9 : 7)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= (resource.data.type == 'PHQ9' ? 27 : 21);

      allow delete: if false;
    }

    match /consent_records/{recordId} {
      allow read: if isMember(resource.data.clinic_id);
      allow create: if isMember(request.resource.data.clinic_id)
        && request.resource.data.id == recordId
        && request.resource.data.status in ['granted', 'withdrawn'];
      allow update, delete: if false;
    }

    match /dpdp_requests/{requestId} {
      allow read: if isOwnerOf(resource.data.clinic_id);
      allow create: if isMember(request.resource.data.clinic_id)
        && request.resource.data.id == requestId
        && request.resource.data.status == 'pending';
      allow update: if isOwnerOf(resource.data.clinic_id) && unchanged(['id', 'clinic_id']);
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwnerOf(resource.data.clinic_id);
      allow create: if isMember(request.resource.data.clinic_id)
        && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
